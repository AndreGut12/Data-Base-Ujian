<style>
:root{--navy:#102a43;--blue:#1677ff;--pale:#eaf3ff;--green:#16a56a;--red:#d9363e;--line:#d9e2ec}*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#f3f7fb;color:#172b4d}.top{background:linear-gradient(135deg,#102a43,#1465b8);color:white;padding:18px 16px}.top h1{font-size:21px;margin:0 0 5px}.top p{margin:0;opacity:.82;font-size:13px}.wrap{max-width:1400px;margin:auto;padding:14px}.toolbar,.summary{background:white;border-radius:15px;padding:12px;box-shadow:0 4px 18px #102a4312;margin-bottom:12px}.toolbar{display:flex;gap:10px;align-items:end;flex-wrap:wrap}.field{display:grid;gap:5px}.field label{font-size:12px;font-weight:700;color:#52667a}select,button{font:inherit;border-radius:10px;padding:10px 13px;border:1px solid var(--line);background:white}select{min-width:160px}button{cursor:pointer;font-weight:700}.danger{color:var(--red);border-color:#ffc4c7;margin-left:auto}.summary{display:flex;gap:14px;justify-content:space-between;align-items:center}.summary b{font-size:18px}.hint{font-size:12px;color:#64788d}.tablebox{background:white;border-radius:15px;box-shadow:0 4px 18px #102a4312;overflow:auto;max-height:72vh}table{border-collapse:separate;border-spacing:0;min-width:1100px;width:100%}th,td{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:8px;text-align:center}thead th{position:sticky;top:0;background:var(--navy);color:white;z-index:3;font-size:12px}.no{width:42px}.name{text-align:left;min-width:245px;position:sticky;left:0;background:white;z-index:1;font-weight:600}.num{padding:5px;width:49px}.check{display:block;width:36px;height:36px;margin:auto;border:2px solid #b8c7d8;border-radius:9px;background:#f9fbfd;color:white;font-size:21px;line-height:28px;padding:0}.check.on{background:var(--green);border-color:var(--green);box-shadow:0 2px 7px #16a56a55}.total{font-weight:800;background:#f6faff}.score{font-weight:900;color:var(--blue);background:var(--pale)}tbody tr:hover td{background:#f7fbff}tbody tr:hover .name{background:#f7fbff}@media(max-width:650px){.wrap{padding:9px}.top{padding:15px 12px}.top h1{font-size:18px}.toolbar{align-items:stretch}.field{flex:1}.danger{margin-left:0}.summary{align-items:flex-start;flex-direction:column;gap:5px}.tablebox{max-height:74vh}.name{min-width:185px;font-size:13px}th,td{padding:6px}}
.manual{width:68px;padding:8px 5px;text-align:center;border:1px solid #aebed0;border-radius:8px;font:inherit;font-weight:700}.grand{font-size:16px;font-weight:900;color:#fff;background:var(--green)}.textinput{min-width:205px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;font:inherit}.yearinput{min-width:105px;width:115px}.pdfbtn{background:#d62828;color:#fff;border-color:#d62828}
</style>
</head><body>
<header class="top"><h1>Penilaian Pilihan Ganda</h1><p>15 soal • setiap jawaban benar bernilai 2 poin • skor maksimal 30</p></header>
<main class="wrap">
 <section class="toolbar"><div class="field"><label for="kelas">Pilih Kelas</label><select id="kelas"></select></div><div class="field"><label for="wali">Nama Wali Kelas</label><input id="wali" class="textinput" placeholder="Ketik nama wali kelas"></div><div class="field"><label for="tahun">Tahun Ajaran</label><input id="tahun" class="textinput yearinput" value="2026/2027"></div><button id="pdf" class="pdfbtn">⬇ Download PDF Rekap</button><button id="all">✓ Ceklis Semua</button><button id="clear" class="danger">Hapus Ceklis Kelas</button></section>
 <section class="summary"><div><span>Kelas aktif: </span><b id="className"></b></div><div class="hint">Ketuk kotak nomor soal untuk memberi atau membatalkan ✓. Data tersimpan otomatis di perangkat ini.</div></section>
 <div class="tablebox"><table><thead><tr id="head"></tr></thead><tbody id="body"></tbody></table></div>
</main>
<script>
const students={
