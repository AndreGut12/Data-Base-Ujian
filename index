'5D':['Abizar Albiansyah Nasution','Afrah Munawir Situmeang','Aidil Amransah Harahap','Akipa Naila Safitri','Alisha Qonita Ritonga','Amira Syahirah Lubis','Dwi Akhtar Nugraha','Fathya Qanita Ismy Gultom','Kayla Azkiya Hutasuhut','Keisya Nahda Ghassani Rangkuti','M. Afkar Al Fatih Hasibuan','Mahfuzhah Sholehah Siregar','Muhammad Al Fathan Efendi Lubis','Rifqi Hamizan Pardomuan Hutasuhut','Rizky Navadena Ritonga','Ukhti Dzakira Hasibuan'],
'6A':['ADYSHA MEYRA HARAHAP','AHMAD AL HABSY ANANTA DAMANIK','AHMAD RIFYAN SITUMORANG','ALIF ZIKRI HADI','ANDRYAN AFNAN SYABIL','AZ ZAHRA LUBIS','BILQIS FAIHA RIFDAH SIREGAR','DEAN IBNU HA BAIHAQQI','EARLYTA ARSYIPA SIREGAR','FAHMI AL MUSLIM NASUTION','HABIBI AMRILLAH PASARIBU','KHOIRUL AZAM RAMBE','MUHAMMAD ADZKA SIREGAR','MUHAMMAD AZZAM SIREGAR','MUHAMMAD SAYYID ALFATIH LUBIS','NADHIFA ASSYIFATU ZHAHIRA','NESWA SYIMATUL IZZAH RITONGA','RAID MUHAMMAD NAZARUDDIN','RAIHANA YASMINA FAIHA PULUNGAN','SAHARA AFIFAH PULUNGAN','SENANDUNG REALITA HARAHAP','SYADDAD LINTANG PALEFI','SYIFA SAUQIYA PANE'],
'6B':['ADIKA PRAYOGA','AHZA DANISH SYAHPUTRA','AISYAH DINA RAISA','AISYAH SHIFA HARAHAP','ALISHA KHAIRA LUBNA HARAHAP','ARIQAH FATINAH SITOMPUL','ATHAYA NAKHLA PANJAITAN','AZKIA FITRI HARAHAP','DAFANIA REVANISA NASUTION','DIRGANTARA AL-FITRA SIMATUPANG','FAHRI WIRA HADI','HABIBAH AZZALFA SIREGAR','HANNAN FAIZ','HASHFY KHANZA SALSABILA HARAHAP','IBRAHIM KHOLIL HARAHAP','MUHAMMAD AFKAR AL KHAWARIZMI SIREGAR','SALMA HAFIZHAH NAINGGOLAN','SOYIBAH BATUBARA','SRI RAHAYU RAMADHANI','WAFIQ AZIZAH HARAHAP'],
'6C':['Abdul Latif Abbasy Siregar','Adibah Shakila Andes','Anis Farhanah Rambe','Arfan Abdul Hafizh Pasaribu','Assyabiya Zylfani Pane','Asyifa Zahra Lubis','Azka Al Fariz Harahap','Azka Syamsi Pratama Daulay','Haruna Shaumi Salim Lubis','Haura Fathia Dalimunthe','Keyla Anastasya Nasution','M. Rafa Azka Siregar','Mahirah Aish Sifiwa Siregar','Mirza Raihansyah Hasibuan','Muhammad Hatta Lubis','Muhammad Sahlun Rizqi Hasibuan','Nafisa Almira','Naufal Aditya','Rozi Abiyyu Harahap','Salman Naila Haura','Syakir Raffasya','Ukhti Wildani Rangkuti','Varisha Pradifta Hidayah Ritonga'],
'6D':['Adzkiya Putri Nasution','Ahmad Syariful Ali Srg','Alzuhri Amaran Sahputra Harahap','Ariqa Sumayyah Nainggolan','Aufa Rifqi Agustian','Citra Ulya Ramadhan Siregar','Fathan Dika Ar-Rafif Hasibuan','Haziq Armaghan Setiawan','Mirza Fathurrahman Siregar','Nazwa Lutfia Zannah','Rania Azka Humaira Harahap','Restu Alqa Setiawan','Ulfah Hana Mahdiah Siregar','Yumna Shakila']};
const KEY='penilaian_pg15_v1',sel=document.querySelector('#kelas'),body=document.querySelector('#body'),wali=document.querySelector('#wali'),tahun=document.querySelector('#tahun');let state=JSON.parse(localStorage.getItem(KEY)||'{}');Object.keys(students).forEach(k=>sel.add(new Option('Kelas '+k,k)));sel.value=localStorage.getItem(KEY+'_class')||'5A';tahun.value=localStorage.getItem(KEY+'_tahun')||'2026/2027';
function save(){localStorage.setItem(KEY,JSON.stringify(state))}function key(c,i){return c+'|'+i}function checks(c,i){return state[key(c,i)]||[]}
function extra(c,i,type){return Number(state[key(c,i)+'|'+type])||0}function updateTotal(tr,c,i){tr.querySelector('.grand').textContent=checks(c,i).filter(Boolean).length*2+extra(c,i,'isian')+extra(c,i,'uraian')}
function render(){const c=sel.value;localStorage.setItem(KEY+'_class',c);wali.value=localStorage.getItem(KEY+'_wali_'+c)||'';document.querySelector('#className').textContent=c;document.querySelector('#head').innerHTML='<th class="no">No.</th><th class="name">Nama Siswa</th>'+Array.from({length:15},(_,i)=>`<th>${i+1}</th>`).join('')+'<th>Benar</th><th>Poin PG</th><th>Isian</th><th>Uraian</th><th>Total</th>';body.innerHTML='';students[c].forEach((name,i)=>{const tr=document.createElement('tr'),arr=checks(c,i),pg=arr.filter(Boolean).length*2,isian=extra(c,i,'isian'),uraian=extra(c,i,'uraian');tr.innerHTML=`<td>${i+1}</td><td class="name">${name}</td>`+Array.from({length:15},(_,q)=>`<td class="num"><button class="check ${arr[q]?'on':''}" data-i="${i}" data-q="${q}" aria-label="${name}, soal ${q+1}">${arr[q]?'✓':''}</button></td>`).join('')+`<td class="total">${arr.filter(Boolean).length}</td><td class="score">${pg}</td><td><input class="manual" type="number" min="0" step="0.5" inputmode="decimal" data-type="isian" data-i="${i}" value="${isian||''}" placeholder="0"></td><td><input class="manual" type="number" min="0" step="0.5" inputmode="decimal" data-type="uraian" data-i="${i}" value="${uraian||''}" placeholder="0"></td><td class="grand">${pg+isian+uraian}</td>`;body.append(tr)})}
body.addEventListener('click',e=>{const b=e.target.closest('.check');if(!b)return;const c=sel.value,i=+b.dataset.i,q=+b.dataset.q,a=checks(c,i);a[q]=!a[q];state[key(c,i)]=a;save();const tr=b.closest('tr'),n=a.filter(Boolean).length;b.classList.toggle('on',a[q]);b.textContent=a[q]?'✓':'';tr.querySelector('.total').textContent=n;tr.querySelector('.score').textContent=n*2;updateTotal(tr,c,i)});body.addEventListener('input',e=>{if(!e.target.classList.contains('manual'))return;const i=+e.target.dataset.i,type=e.target.dataset.type,c=sel.value;state[key(c,i)+'|'+type]=Math.max(0,Number(e.target.value)||0);save();updateTotal(e.target.closest('tr'),c,i)});sel.onchange=render;
document.querySelector('#clear').onclick=()=>{if(confirm('Hapus seluruh ceklis serta nilai Isian dan Uraian untuk kelas '+sel.value+'?')){students[sel.value].forEach((_,i)=>{delete state[key(sel.value,i)];delete state[key(sel.value,i)+'|isian'];delete state[key(sel.value,i)+'|uraian']});save();render()}};
document.querySelector('#all').onclick=()=>{if(confirm('Ceklis semua nomor untuk seluruh siswa kelas '+sel.value+'?')){students[sel.value].forEach((_,i)=>state[key(sel.value,i)]=Array(15).fill(true));save();render()}};render();
wali.addEventListener('input',()=>localStorage.setItem(KEY+'_wali_'+sel.value,wali.value));tahun.addEventListener('input',()=>localStorage.setItem(KEY+'_tahun',tahun.value));
function esc(v){return String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
document.querySelector('#pdf').onclick=()=>{const c=sel.value,yr=tahun.value.trim()||'2026/2027',teacher=wali.value.trim()||'-';const rows=students[c].map((name,i)=>{const a=checks(c,i),pg=a.filter(Boolean).length*2,isian=extra(c,i,'isian'),uraian=extra(c,i,'uraian');return `<tr><td>${i+1}</td><td class="nm">${esc(name)}</td>${Array.from({length:15},(_,q)=>`<td>${a[q]?'✓':'–'}</td>`).join('')}<td class="bold">${pg}</td><td>${isian}</td><td>${uraian}</td><td class="bold">${pg+isian+uraian}</td></tr>`}).join('');const w=window.open('','_blank');if(!w){alert('Izinkan pop-up pada aplikasi pembaca HTML, lalu coba kembali.');return}w.document.write(`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rekap ASTS Kelas ${esc(c)}</title><style>@page{size:A4 landscape;margin:8mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#111;margin:0}.actions{position:sticky;top:0;z-index:9;display:flex;gap:10px;justify-content:center;padding:12px;background:#102a43;box-shadow:0 2px 8px #0004}.actions button{border:0;border-radius:9px;padding:11px 18px;color:#fff;font-size:14px;font-weight:700;cursor:pointer}.back{background:#60758a}.download{background:#d62828}.page{padding:12px}.head{text-align:center;margin-bottom:7px}.head h1{font-size:17px;margin:0 0 3px;text-transform:uppercase}.head h2{font-size:14px;margin:0 0 3px}.info{display:grid;grid-template-columns:1fr 1fr;margin:7px 0;font-size:11px}.info div:nth-child(even){text-align:right}table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:8px}th,td{border:1px solid #222;padding:3px 1px;text-align:center;height:18px}th{background:#dce6f1;font-weight:700}.nm{text-align:left;padding-left:4px;width:168px}.no{width:22px}.q{width:23px}.wide{width:42px}.bold{font-weight:700}.sign{margin-top:10px;margin-left:auto;width:220px;text-align:center;font-size:10px}.space{height:42px}@media print{.actions{display:none}.page{padding:0}body{-webkit-print-color-adjust:exact;print-color-adjust:exact}}</style></head><body><div class="actions"><button class="back" onclick="window.close()">← Kembali</button><button class="download" onclick="window.print()">⬇ Download PDF</button></div><div class="page"><div class="head"><h1>Rekap Nilai Ujian Asesmen Sumatif Tengah Semester</h1><h2>Tahun Ajaran ${esc(yr)}</h2></div><div class="info"><div><b>Kelas:</b> ${esc(c)}</div><div><b>Nama Wali Kelas:</b> ${esc(teacher)}</div></div><table><thead><tr><th class="no">No.</th><th class="nm">Nama</th>${Array.from({length:15},(_,i)=>`<th class="q">${i+1}</th>`).join('')}<th class="wide">Poin PG</th><th class="wide">Isian</th><th class="wide">Uraian</th><th class="wide">Total</th></tr></thead><tbody>${rows}</tbody></table><div class="sign"><div>Padangsidimpuan, ........................ 2026</div><div>Guru Matematika</div><div class="space"></div><div><b>Rezki Andrian Jahri Lubis, S.Mat.</b></div></div></div></body></html>`);w.document.close()};
</script></body></html>
